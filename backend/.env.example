DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=skillswap
DB_SSL=false
# For hosted MySQL requiring TLS, set DB_SSL=true. For certificate verification,
# paste the provider's CA certificate into DB_SSL_CA.
DB_SSL_CA=
PORT=3000
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
